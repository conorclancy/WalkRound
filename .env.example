# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 0) ------------------------------------------------------
# Local: run `npx supabase status` after `npx supabase start` and copy the values.
# Hosted: Supabase dashboard → Project Settings → API Keys (EU region project).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS — use only in lib/server/ and Edge Functions.
SUPABASE_SECRET_KEY=

# --- Auth providers (Phase 1) — read via env() in supabase/config.toml -----
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SMS provider (Twilio) for phone OTP at sign-up
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- AI comparison (Phase 4) — Edge Function secrets -------------------------
# gemini | claude
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email (Phase 5) — Resend ------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="WalkRound <reports@walkround.ie>"

# --- Billing (Phase 6) — Stripe (test mode keys while building) --------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Monitoring (Phase 8) — Sentry -------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
